{
  "manifest_version": 3,
  "name": "Score Bayesiano — Mercado Livre",
  "version": "0.2.0",
  "description": "Calcula um score bayesiano (nota ajustada pela quantidade de avaliações) para os produtos da busca do Mercado Livre.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lista.mercadolivre.com.br/*",
        "https://*.mercadolivre.com.br/*"
      ],
      "js": ["src/bayes.js", "src/pages.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Score Bayesiano",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
